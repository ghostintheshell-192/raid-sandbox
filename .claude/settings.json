{
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "WebSearch"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | python3 \"$(git rev-parse --show-toplevel)/.development/scripts/session-archive.py\"' || true"
          }
        ]
      }
    ]
  }
}

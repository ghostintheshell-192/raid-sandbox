#!/bin/bash
# Pre-commit module: derived-docs regeneration.
#
# Delegates to the project's docs-update entry point and stages whatever
# generated files changed. It knows nothing about the generators themselves —
# that knowledge lives in .development/automation/docs-update.sh.
#
# This overlaps with the SessionStart hook in .claude/settings.json but does
# not duplicate it: that one refreshes the docs when a session opens, this one
# guarantees the commit itself never carries stale derived docs.
#
# Never blocks: derived docs are an output, not a gate.

GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
ENTRY_POINT="$PROJECT_ROOT/.development/automation/docs-update.sh"

if [[ ! -x "$ENTRY_POINT" ]]; then
    exit 0
fi

echo -e "${BLUE}[Derived Docs]${NC}"

(cd "$PROJECT_ROOT" && "$ENTRY_POINT") | sed 's/^/  /'

# Every file docs-update.sh regenerates. This list held only ARCHITECTURE.md
# while INDEX.md and tech-debt/README.md were gitignored — correct then, since
# staging an ignored path is an error. 1e55217 started tracking both, and this
# list was not part of that change: they were regenerated on every commit and
# staged on none, left modified in the working tree instead. The conflict on
# parallel branches that motivated ignoring them is handled now by the
# merge=generated driver in .gitattributes.
#
# `kb` is a directory, not a file: generate-kb.js writes one page per level plus
# the map, the concepts page and the glossary, and removes a page it no longer
# produces. Staging the directory picks up all three cases (changed, created,
# deleted) in one `git add`.
GENERATED=(
    ".development/ARCHITECTURE.md"
    ".development/INDEX.md"
    ".development/tech-debt/README.md"
    "kb"
)

# Add unconditionally: `git add` on an unchanged tracked file is a no-op, so
# the pre-test bought nothing and got the create case wrong. It used to be
# `git diff --quiet <file>`, which reports no difference for a file git does
# not track yet — so whenever a generator CREATED its output rather than
# updating it (a fresh clone, a deleted file), the new file was left untracked
# and the hook announced the docs were already current.
STAGED=()
for file in "${GENERATED[@]}"; do
    [[ -e "$PROJECT_ROOT/$file" ]] || continue
    git add "$PROJECT_ROOT/$file"
    STAGED+=("$PROJECT_ROOT/$file")
done

if [[ ${#STAGED[@]} -gt 0 ]] && ! git diff --cached --quiet -- "${STAGED[@]}" 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} Regenerated docs staged"
else
    echo -e "  ${GREEN}✓${NC} Derived docs already current"
fi

exit 0

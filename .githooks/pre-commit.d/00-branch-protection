#!/bin/bash
# Pre-commit module: branch protection for `main`.
#
# NOTHING is authored directly on `main` — documentation included. Only merges
# land here.
#
# This used to admit doc-only commits (`*.md`, `.development/`), on the argument
# that a single maintainer should be able to land a doc fix without the PR
# ceremony. Tried, and dropped 2026-07-25: the derived docs (`INDEX.md`,
# `tech-debt/README.md`) are regenerated on every commit, so a doc commit on main
# while a branch is open conflicts with that branch's own regenerated copies.
# Every such conflict forces a merge into the open branch, which creates a new
# head SHA, which needs a fresh CI run — one of which hung and had to be force
# merged. The convenience was worth less than the merge friction it produced.
#
# There is no `develop` branch on this project, and no spec-workflow hook — the
# scaffold's clauses for both were dropped rather than carried over dead.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)

echo -e "${GREEN}[Branch Protection]${NC} Checking current branch..."

if [ "$BRANCH" != "main" ]; then
    echo -e "${GREEN}✓ Branch '$BRANCH' OK${NC}"
    exit 0
fi

# Merges are the expected way to get work into main; only direct authoring
# of new work is what this module is about.
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
    echo -e "${GREEN}✓ Merge commit on 'main' allowed${NC}"
    exit 0
fi

echo ""
echo -e "${RED}═══════════════════════════════════════════════${NC}"
echo -e "${RED}  COMMIT BLOCCATO: su 'main' si mergia soltanto${NC}"
echo -e "${RED}═══════════════════════════════════════════════${NC}"
echo ""
echo -e "${YELLOW}File staged:${NC}"
git diff --cached --name-only | sed 's/^/    /'
echo ""
echo -e "${YELLOW}Crea un branch dedicato — anche per la sola documentazione:${NC}"
echo ""
echo "  git checkout -b feature/nome-feature"
echo "  git checkout -b fix/nome-bug"
echo "  git checkout -b refactor/descrizione"
echo "  git checkout -b docs/argomento"
echo ""
echo -e "${YELLOW}Per bypass (NON RACCOMANDATO):${NC}"
echo "  git commit --no-verify"
echo ""
exit 1

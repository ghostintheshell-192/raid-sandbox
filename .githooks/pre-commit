#!/bin/bash
# Git pre-commit hook — orchestrator.
#
# Runs every executable module in pre-commit.d/ in numeric order and reports
# them all before failing, so one commit attempt surfaces every problem
# instead of stopping at the first.
#
# Activated per clone by .development/automation/bootstrap.sh
# (git config core.hooksPath .githooks). Git will not enable it on its own.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

HOOK_DIR="$(dirname "$0")/pre-commit.d"

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Pre-Commit Checks${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

if [ ! -d "$HOOK_DIR" ]; then
    echo -e "${YELLOW}⚠ WARNING:${NC} No pre-commit.d/ directory found"
    exit 0
fi

FAILED=0
for hook in "$HOOK_DIR"/*; do
    if [ -f "$hook" ] && [ -x "$hook" ]; then
        "$hook"
        if [ $? -ne 0 ]; then
            FAILED=1
            # Deliberately no early exit: report every failing check.
        fi
    fi
done

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ $FAILED -eq 1 ]; then
    echo -e "${RED}✗ Pre-commit checks FAILED${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    exit 1
else
    echo -e "${GREEN}✓ All pre-commit checks PASSED${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    exit 0
fi

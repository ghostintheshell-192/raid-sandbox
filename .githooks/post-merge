#!/bin/bash
# Post-merge hook: bring derived state up to date after a merge — the merged
# branch's spec moves to implemented/, and the generated documentation is
# regenerated against the merged tree.
#
# Why post-merge and not pre-commit: git creates no-conflict merge commits
# directly, WITHOUT running pre-commit (that only fires on `git commit`,
# i.e. conflicted merges concluded manually). MERGE_HEAD is already gone
# here, so the merged branch is parsed from the merge commit subject.
#
# That same fact is why the derived docs belong here too. pre-commit.d/04-docs-update
# never sees a merge, so two branches that each touched .development/ used to
# meet on the integration branch with documentation describing neither tree,
# until someone noticed and regenerated by hand. See
# tech-debt/post-merge-does-not-regenerate-derived-docs.md.
#
# The docs step *invokes* that pre-commit module rather than reimplementing it:
# one piece of code deciding what to regenerate and what to stage, reached from
# two triggers. A second copy here would be one more hand-kept list of the
# generators' outputs, which is the failure this repo keeps rediscovering.
#
# Whatever gets staged is staged, not committed. Folding it into the merge
# commit with `--amend` from inside this hook is impossible: git still keeps
# MERGE_HEAD around while post-merge runs, and `commit --amend` refuses
# during a merge. Deleting MERGE_HEAD ourselves would mean depending on
# git's internal cleanup ordering — not worth it. So: stage + tell the
# operator to amend (one command, right after the merge).

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[[ -n "$PROJECT_ROOT" ]] || exit 0

SPEC_SCRIPT="$PROJECT_ROOT/.development/scripts/spec-workflow.py"
HOOKS_DIR="$PROJECT_ROOT/$(git rev-parse --git-path hooks)"
DOCS_MODULE="$HOOKS_DIR/pre-commit.d/04-docs-update"

# Branches that work lands on. A list, not one hardcoded name: a project whose
# integration branch is `main` would otherwise inherit a hook that exits
# silently on every merge — worse than no hook, because it looks covered.
INTEGRATION_BRANCHES=("develop" "main")

CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
ON_INTEGRATION=0
for branch in "${INTEGRATION_BRANCHES[@]}"; do
    [[ "$CURRENT_BRANCH" == "$branch" ]] && ON_INTEGRATION=1
done
[[ $ON_INTEGRATION -eq 1 ]] || exit 0

# Only act if HEAD is a merge commit (two or more parents).
PARENTS=$(git rev-list --parents -n 1 HEAD | wc -w)
[[ "$PARENTS" -ge 3 ]] || exit 0

# ─── Spec lifecycle ────────────────────────────────────────────────────

if [[ -f "$SPEC_SCRIPT" ]]; then
    SUBJECT=$(git log -1 --format='%s')
    MERGED_BRANCH=$(echo "$SUBJECT" | sed -n "s/.*Merge branch '\([^']*\)'.*/\1/p")

    case "$MERGED_BRANCH" in
        feature/*|fix/*|docs/*|experiment/*|refactor/*)
            SPEC_NAME="${MERGED_BRANCH#*/}"
            OUTPUT=$(python3 "$SPEC_SCRIPT" done "$SPEC_NAME" 2>/dev/null)
            if [[ -n "$OUTPUT" ]]; then
                echo -e "${BLUE}[post-merge] Spec Workflow${NC}"
                echo -e "$OUTPUT"
                git add "$PROJECT_ROOT/.development/specs/"
            fi
            ;;
    esac
fi

# ─── Derived documentation ─────────────────────────────────────────────
# Unconditional on the branch prefix, unlike the spec step: a chore/ branch
# carries no spec but can still add a tech-debt note, archive one, or move a
# file the generators read.

if [[ -x "$DOCS_MODULE" ]]; then
    "$DOCS_MODULE"
fi

# ─── Fold in, or hand over ─────────────────────────────────────────────

# Nothing staged means nothing to fold — stay silent rather than instructing
# the operator to amend an unchanged commit.
if git diff --cached --quiet 2>/dev/null; then
    exit 0
fi

# Amend is impossible while MERGE_HEAD exists (see header). If a future
# git version runs post-merge after state cleanup, fold automatically;
# otherwise hand the one-liner to the operator.
if [[ ! -e "$PROJECT_ROOT/.git/MERGE_HEAD" ]] \
    && [[ -z "$(git branch -r --contains HEAD 2>/dev/null)" ]] \
    && git commit --amend --no-edit --no-verify --quiet 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} Folded into the merge commit"
else
    echo -e "  ${YELLOW}→${NC} Changes staged. Fold them into the merge with:"
    echo -e "      git commit --amend --no-edit"
fi

exit 0

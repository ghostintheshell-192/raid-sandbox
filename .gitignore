# ---- Session / personal (never tracked) ----
.personal/

# Memory bank: handoffs and session transcripts stay local (per-machine),
# but tangential idea notes are tracked as provenance.
.memory-bank/*
!.memory-bank/ideas/

# NOTE: .development/ IS tracked in full — design docs, specs, tech-debt, the
# session-archive script, and the derived docs too.
#
# INDEX.md and tech-debt/README.md were excluded here until 2026-08-29, because
# 04-docs-update regenerates them on every commit and they carried a generation
# timestamp, so two branches diverged there even when neither had touched a real
# file. The criterion was right and stated in this very note — ARCHITECTURE.md
# stayed tracked because it is deterministic, same sources same bytes. The
# generators are now deterministic too: no clock, no mtimes. So the exclusion
# has no reason left, and it had a cost — see 1e55217.

# ---- Claude Code local / per-machine ----
.claude/settings.local.json
.claude/agents

# Harness-injected runtime artifacts show up as sandbox char devices (not real
# files), so the trailing-slash patterns miss them — match them bare too.
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/workflows
.mcp.json
.tmp/

# Agents run in git worktrees under the project (one per agent); the checkouts
# are throwaway, the branches they produce are what gets kept.
.claude/worktrees/

# ---- Shell & system dotfiles (sandbox artifacts) ----
.bash_profile
.bashrc
.profile
.zprofile
.zshrc

# ---- Git config (global, not project) ----
.gitconfig
.gitmodules

# ---- Tool config ----
.ripgreprc

# ---- IDE ----
.idea
.idea/
.vscode
.vscode/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Node (the game is zero-dependency, but tests run under node) ----
node_modules/
coverage/
npm-debug.log*

# ---- Python bytecode (the doc generators in .development/scripts/) ----
__pycache__/
*.pyc

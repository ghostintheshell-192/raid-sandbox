# ---- Session / personal (never tracked) ----
.personal/

# Memory bank: handoffs and session transcripts stay local (per-machine),
# but tangential idea notes are tracked as provenance.
.memory-bank/*
!.memory-bank/ideas/

# NOTE: .development/ IS tracked — design docs, specs, tech-debt and the
# session-archive script live with the code.
#
# ...except the two *indexes*, which are derived and regenerate from what is
# already in the repo. Tracking them bought nothing and cost a conflict on
# every parallel branch: 04-docs-update regenerates them on each commit, and
# INDEX.md carries a generation timestamp, so two branches diverge there even
# when neither changed a real file. Rebuild with .development/automation/docs-update.sh
# (the SessionStart hook already does it). ARCHITECTURE.md stays tracked: it is
# imported into every session as the navigation map, and it is deterministic —
# same sources, same bytes — so it does not collide.
.development/INDEX.md
.development/tech-debt/README.md

# ---- Claude Code local / per-machine ----
.claude/settings.local.json
.claude/agents

# Harness-injected runtime artifacts show up as sandbox char devices (not real
# files), so the trailing-slash patterns miss them — match them bare too.
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/workflows
.mcp.json
.tmp/

# ---- Shell & system dotfiles (sandbox artifacts) ----
.bash_profile
.bashrc
.profile
.zprofile
.zshrc

# ---- Git config (global, not project) ----
.gitconfig
.gitmodules

# ---- Tool config ----
.ripgreprc

# ---- IDE ----
.idea
.idea/
.vscode
.vscode/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Node (the game is zero-dependency, but tests run under node) ----
node_modules/
coverage/
npm-debug.log*

# ---- Python bytecode (the doc generators in .development/scripts/) ----
__pycache__/
*.pyc
